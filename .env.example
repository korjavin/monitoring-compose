# =================================================================
# Monitoring Stack (.env)
# =================================================================

# -----------------------------------------------------------------
# 1. Host & Routing (Traefik)
# -----------------------------------------------------------------
# Domain used to access Grafana UI
GRAFANA_HOST=grafana.example.com

# External Traefik network (existing proxy network)
TRAEFIK_NETWORK_NAME=traefik_default

# Traefik certresolver for Let's Encrypt certificates
TRAEFIK_CERTRESOLVER=myresolver

# -----------------------------------------------------------------
# 2. Pocket-ID (OIDC) Authentication
# -----------------------------------------------------------------
# Set up an OIDC client application in Pocket-ID dashboard:
#   Name: Grafana
#   Redirect URI: https://<GRAFANA_HOST>/login/generic_oauth
#   (e.g., https://grafana.example.com/login/generic_oauth)
POCKET_ID_HOST=id.example.com
POCKET_ID_CLIENT_ID=your-pocket-id-client-id
POCKET_ID_CLIENT_SECRET=your-pocket-id-client-secret

# Grafana local admin account fallback (available via standard login)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_super_secret_admin_pass

# -----------------------------------------------------------------
# 3. Data Retention
# -----------------------------------------------------------------
# VictoriaMetrics retention period (e.g. 1y, 6m, 90d)
VM_RETENTION_PERIOD=1y

# VictoriaLogs retention period (e.g. 30d, 90d)
VLOGS_RETENTION_PERIOD=30d

# -----------------------------------------------------------------
# 4. Images (GHCR Vendored / Defaults)
# -----------------------------------------------------------------
# Set automatically in deploy branch or customize manually
GRAFANA_IMAGE=ghcr.io/korjavin/monitoring-grafana-vendor:latest
VICTORIAMETRICS_IMAGE=ghcr.io/korjavin/monitoring-victoriametrics-vendor:latest
VICTORIALOGS_IMAGE=ghcr.io/korjavin/monitoring-victorialogs-vendor:latest
VMAGENT_IMAGE=ghcr.io/korjavin/monitoring-vmagent-vendor:latest
VECTOR_IMAGE=ghcr.io/korjavin/monitoring-vector-vendor:latest

# -----------------------------------------------------------------
# 5. Volumes & Internal Network
# -----------------------------------------------------------------
INTERNAL_NETWORK_NAME=monitoring_internal
GRAFANA_DATA_VOLUME=monitoring_grafana_data
VM_DATA_VOLUME=monitoring_vm_data
VLOGS_DATA_VOLUME=monitoring_vmlogs_data
VMAGENT_DATA_VOLUME=monitoring_vmagent_data
VECTOR_DATA_VOLUME=monitoring_vector_data
